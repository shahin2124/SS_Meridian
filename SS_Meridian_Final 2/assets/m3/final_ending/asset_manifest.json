{
  "root": "assets/final_ending",
  "purpose": "SS Meridian final ending after Mission 3 Power Stone claim",
  "authoritative_sequence": [
    "arena dialogue with Guide",
    "submit Space Stone",
    "submit Mind Stone",
    "submit Power Stone",
    "completed Hand of Three final glow",
    "black countdown 1, 2, 3 (render in code)",
    "ship interior",
    "Issac walks to Homecoming door",
    "Homecoming door opens; ENTER prompt rendered in code",
    "beach; Issac walks about 10 seconds",
    "sun rises continuously using separate sun sprite movement",
    "reflection and wave loops animate",
    "Issac stops and watches sunrise",
    "countdown 1, 2, 3 and fade to black (render in code)",
    "Journey of Issac final screen"
  ],
  "rules": [
    "Use only assets in this package for the new final ending.",
    "Do not substitute similarly named assets from elsewhere.",
    "Do not regenerate, resize, recolor, or modify visual assets.",
    "Use hand/hand_three_space_only.png and hand/hand_three_space_mind.png; old generated intermediate Hand images were intentionally excluded.",
    "Render HOMECOMING, PRESS ENTER, dialogue text, countdown numbers, and THE JOURNEY OF ISSAC with code.",
    "Render all Hand states and Hand VFX into one fixed destination rectangle to avoid any source-canvas off-by-one differences."
  ],
